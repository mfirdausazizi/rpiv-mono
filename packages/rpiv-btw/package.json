{
  "name": "@juicesharp/rpiv-btw",
  "version": "2.2.0",
  "description": "Pi extension. Ask side questions with the session model or a global model override without polluting the main conversation.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "rpiv",
    "btw",
    "side-question",
    "overlay"
  ],
  "type": "module",
  "license": "MIT",
  "author": "juicesharp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juicesharp/rpiv-mono.git",
    "directory": "packages/rpiv-btw"
  },
  "homepage": "https://github.com/juicesharp/rpiv-mono/tree/main/packages/rpiv-btw#readme",
  "bugs": {
    "url": "https://github.com/juicesharp/rpiv-mono/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run"
  },
  "files": [
